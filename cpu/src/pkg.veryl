/// RISC-V RV32I definitions: opcodes, funct3, funct7, ALU control,
/// pipeline register payloads and memory bus structs.
pub package riscv_pkg {
    // ------------------------------------------------------------------
    // RV32I major opcodes (instruction[6:0])
    // ------------------------------------------------------------------
    enum Opcode: logic<7> {
        OP_LUI    = 7'h37,
        OP_AUIPC  = 7'h17,
        OP_JAL    = 7'h6F,
        OP_JALR   = 7'h67,
        OP_BRANCH = 7'h63,
        OP_LOAD   = 7'h03,
        OP_STORE  = 7'h23,
        OP_ALUI   = 7'h13,
        OP_ALUR   = 7'h33,
        OP_FENCE  = 7'h0F,
        OP_SYSTEM = 7'h73,
    }

    // ------------------------------------------------------------------
    // ALU control (decoded by the ID stage)
    // ------------------------------------------------------------------
    enum AluOp: logic<4> {
        ADD  = 4'd0,
        SUB  = 4'd1,
        SLL  = 4'd2,
        SLT  = 4'd3,
        SLTU = 4'd4,
        XOR  = 4'd5,
        OR   = 4'd6,
        AND  = 4'd7,
        PASS = 4'd8, // pass operand b straight through (LUI / PC+4)
        SHR  = 4'd9, // logical shift right (SRL)
    }

    // ------------------------------------------------------------------
    // register-file write-back source (decoded by the ID stage)
    // ------------------------------------------------------------------
    enum WbSel: logic<2> {
        ALU    = 2'd0,
        MEMORY = 2'd1,
        PC4    = 2'd2,
        PC     = 2'd3, // pc itself (MRET return address)
    }

    // ------------------------------------------------------------------
    // immediate encoding form (decoded by the ID stage)
    // ------------------------------------------------------------------
    enum ImmSel: logic<3> {
        NONE   = 3'd0,
        I      = 3'd1,
        S      = 3'd2,
        B      = 3'd3,
        U      = 3'd4,
        J      = 3'd5,
    }

    // ------------------------------------------------------------------
    // pipeline control bits, generated by ID, propagated by EX
    // ------------------------------------------------------------------
    struct Ctrl {
        valid  : logic,      // the instruction is live
        illegal: logic,      // un-decodable instruction
        regwrite: logic,     // writes a register
        wb_sel : WbSel,      // write-back source
        aluop  : AluOp,      // ALU operation
        imm_sel: ImmSel,     // immediate form
        alu_src: logic,      // 1: second ALU operand is the immediate
        pc_src : logic,      // 1: first ALU operand is pc (AUIPC)
        mem_read: logic,     // load
        mem_write: logic,    // store
        funct3 : logic<3>,   // load/store sub-op, forwarded to MEM
        branch : logic,      // conditional branch
        jump   : logic,      // JAL / JALR
        csr_en : logic,      // CSR read/write
        sra    : logic,      // arithmetic shift (SRA) instead of logical
        mret   : logic,      // MRET: return from trap
        ebreak : logic,      // EBREAK instruction
    }

    // ------------------------------------------------------------------
    // IF/ID pipeline register payload
    // ------------------------------------------------------------------
    struct IfId {
        valid: logic,     // 0 = flushed bubble (insn contents meaningless)
        pc  : logic<32>,
        insn: logic<32>,
    }

    // ------------------------------------------------------------------
    // ID/EX pipeline register payload
    // ------------------------------------------------------------------
    struct IdEx {
        pc      : logic<32>,
        imm     : logic<32>,
        rs1_data: logic<32>,
        rs2_data: logic<32>,
        csr_src : logic<32>, // rs1 or zimm, the CSR write source
        insn    : logic<32>, // raw instruction (EX needs a few fields)
        rd      : logic<5>,
        ctrl    : Ctrl,
    }

    // ------------------------------------------------------------------
    // EX/MEM pipeline register payload
    // ------------------------------------------------------------------
    struct ExMem {
        pc      : logic<32>,
        alu     : logic<32>, // memory address or ALU result
        store   : logic<32>, // store data (== rs2_data)
        wbvalue : logic<32>, // value destined for rd (non-load)
        rd      : logic<5>,
        ctrl    : Ctrl,
    }

    // ------------------------------------------------------------------
    // MEM/WB pipeline register payload
    // ------------------------------------------------------------------
    struct MemWb {
        pc      : logic<32>,
        alu     : logic<32>,
        memdata : logic<32>,
        rd      : logic<5>,
        ctrl    : Ctrl,
    }

    // ------------------------------------------------------------------
    // instruction-memory request from the IF stage
    // ------------------------------------------------------------------
    struct IfReq {
        valid: logic,
        addr : logic<32>,
    }

    // ------------------------------------------------------------------
    // data-memory request from the MEM stage
    // ------------------------------------------------------------------
    struct MemReq {
        valid : logic,
        write : logic,
        addr  : logic<32>,
        wdata : logic<32>,
        funct3: logic<3>,
    }

    // ------------------------------------------------------------------
    // pipeline flush / stall control
    // ------------------------------------------------------------------
    struct PipeCtrl {
        flush_if_id: logic, // squash instruction in IF/ID
        flush_id_ex: logic, // squash instruction in ID/EX
        flush_ex_mem: logic, // squash instruction in EX/MEM
        stall_if   : logic, // hold PC
        stall_id   : logic, // hold IF/ID
        stall_ex   : logic, // hold ID/EX
    }

    // ------------------------------------------------------------------
    // helpers
    // ------------------------------------------------------------------

    /// an all-zero (bubble) control word
    const CTRL_NOP: Ctrl = Ctrl'{
        valid   : 0,
        illegal : 0,
        regwrite: 0,
        wb_sel  : WbSel::ALU,
        aluop   : AluOp::ADD,
        imm_sel : ImmSel::NONE,
        alu_src : 0,
        pc_src  : 0,
        mem_read: 0,
        mem_write: 0,
        funct3  : 0,
        branch  : 0,
        jump    : 0,
        csr_en  : 0,
        sra     : 0,
        mret    : 0,
        ebreak  : 0,
    };

    /// sign-extend a 12-bit immediate to 32 bits
    function sext12 (
        imm: input logic<12>,
    ) -> logic<32> {
        return {imm[msb] repeat 20, imm};
    }

    /// sign-extend the 20-bit upper immediate to 32 bits
    function sext_u20 (
        imm: input logic<20>,
    ) -> logic<32> {
        return {imm[msb] repeat 12, imm};
    }
}
