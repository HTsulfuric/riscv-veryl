#[test(test_stall)]
module test_stall {
    inst clk: $tb::clock_gen;
    #[allow(initial_assign)]
    var rst: reset;

    var halt: logic;
    var retire: logic;
    var rpc: logic<32>;
    var rrd: logic<5>;
    var rwdata: logic<32>;
    #[allow(initial_assign)]
    var load_en: logic;
