        load_addr = 30'd87; load_wdata = 32'h00000000; clk.next();
        load_addr = 30'd88; load_wdata = 32'h00000000; clk.next();
        load_addr = 30'd89; load_wdata = 32'h00000000; clk.next();
        load_addr = 30'd90; load_wdata = 32'h00000000; clk.next();
        load_addr = 30'd91; load_wdata = 32'h00000000; clk.next();
        load_addr = 30'd92; load_wdata = 32'h00000000; clk.next();
        load_addr = 30'd93; load_wdata = 32'h00000000; clk.next();
        load_en = 0;
        rst = 0;
        // run and check trace
        n = 0;
        for cyc in 0..4000 {
            clk.next();
            if retire && n <= 52 - 1 {
                $assert(rpc == gpc[n], "pc mismatch at %d: %h != %h", n, rpc, gpc[n]);
                $assert(rrd == grd[n], "rd mismatch at %d: %d != %d", n, rrd, grd[n]);
                if grd[n] != 0 {
                    $assert(rwdata == gwd[n], "wdata mismatch at %d pc=%h: %h != %h", n, rpc, rwdata, gwd[n]);
                }
                n += 1;
            }
            if halt {
                break;
            }
        }
        $assert(n == 52, "retired %d instructions, expected %d", n, 52);
        for i in 0..65 {
            $assert(dut.mem[gaddr[i]] == gmem[i], "mem[%d] mismatch: %h != %h", gaddr[i], dut.mem[gaddr[i]], gmem[i]);
        }
        $finish();
    }
}

