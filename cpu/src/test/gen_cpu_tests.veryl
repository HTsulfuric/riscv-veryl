        gmem[1] = 32'h5aa08093; gaddr[1] = 30'd1;
        gmem[2] = 32'h34009073; gaddr[2] = 30'd2;
        gmem[3] = 32'h34002173; gaddr[3] = 30'd3;
        gmem[4] = 32'h0f0f11b7; gaddr[4] = 30'd4;
        gmem[5] = 32'hf0f18193; gaddr[5] = 30'd5;
        gmem[6] = 32'h34019073; gaddr[6] = 30'd6;
        gmem[7] = 32'h3402d073; gaddr[7] = 30'd7;
        gmem[8] = 32'h3402f273; gaddr[8] = 30'd8;
        gmem[9] = 32'h340022f3; gaddr[9] = 30'd9;
        gmem[10] = 32'h00a00313; gaddr[10] = 30'd10;
        gmem[11] = 32'h34031073; gaddr[11] = 30'd11;
        gmem[12] = 32'h3402e3f3; gaddr[12] = 30'd12;
        gmem[13] = 32'h34002473; gaddr[13] = 30'd13;
        gmem[14] = 32'h3407f4f3; gaddr[14] = 30'd14;
        gmem[15] = 32'h34002573; gaddr[15] = 30'd15;
        gmem[16] = 32'h00100073; gaddr[16] = 30'd16;
        gmem[17] = 32'h0000006f; gaddr[17] = 30'd17;
    }

    initial {
        // hold the core in reset while loading the program
        // (RAM itself has no reset)
        rst = 1;
        load_en = 1;
        load_addr = 30'd0; load_wdata = 32'h55aa50b7; clk.next();
        load_addr = 30'd1; load_wdata = 32'h5aa08093; clk.next();
        load_addr = 30'd2; load_wdata = 32'h34009073; clk.next();
        load_addr = 30'd3; load_wdata = 32'h34002173; clk.next();
        load_addr = 30'd4; load_wdata = 32'h0f0f11b7; clk.next();
        load_addr = 30'd5; load_wdata = 32'hf0f18193; clk.next();
        load_addr = 30'd6; load_wdata = 32'h34019073; clk.next();
        load_addr = 30'd7; load_wdata = 32'h3402d073; clk.next();
        load_addr = 30'd8; load_wdata = 32'h3402f273; clk.next();
        load_addr = 30'd9; load_wdata = 32'h340022f3; clk.next();
        load_addr = 30'd10; load_wdata = 32'h00a00313; clk.next();
        load_addr = 30'd11; load_wdata = 32'h34031073; clk.next();
        load_addr = 30'd12; load_wdata = 32'h3402e3f3; clk.next();
        load_addr = 30'd13; load_wdata = 32'h34002473; clk.next();
        load_addr = 30'd14; load_wdata = 32'h3407f4f3; clk.next();
        load_addr = 30'd15; load_wdata = 32'h34002573; clk.next();
        load_addr = 30'd16; load_wdata = 32'h00100073; clk.next();
        load_addr = 30'd17; load_wdata = 32'h0000006f; clk.next();
        load_en = 0;
        rst = 0;
        // run and check trace
        n = 0;
        for cyc in 0..4000 {
            clk.next();
            if retire && n <= 16 - 1 {
                $assert(rpc == gpc[n], "pc mismatch at %d: %h != %h", n, rpc, gpc[n]);
                $assert(rrd == grd[n], "rd mismatch at %d: %d != %d", n, rrd, grd[n]);
                if grd[n] != 0 {
                    $assert(rwdata == gwd[n], "wdata mismatch at %d pc=%h: %h != %h", n, rpc, rwdata, gwd[n]);
                }
                n += 1;
            }
            if halt {
                break;
            }
        }
        $assert(n == 16, "retired %d instructions, expected %d", n, 16);
        for i in 0..18 {
            $assert(dut.mem[gaddr[i]] == gmem[i], "mem[%d] mismatch: %h != %h", gaddr[i], dut.mem[gaddr[i]], gmem[i]);
        }
        $finish();
    }
}

